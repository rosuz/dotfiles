#!/bin/bash
set -euo pipefail

ACTION="${1:-}"
OUTPUT_DIR="$HOME/Videos/Screenrecord"
RECORDING_FILE="/tmp/screenrecord-filename"
DESKTOP_AUDIO="true"

mkdir -p "$OUTPUT_DIR"

get_audio_device() {
  pactl get-default-sink | sed 's/$/.monitor/'
}

start_recording() {
  local filepath="$1"

  local audio_args=()
  [[ "$DESKTOP_AUDIO" == "true" ]] && audio_args+=(-a "$(get_audio_device)")

  gpu-screen-recorder -w screen -o "$filepath" -fallback-cpu-encoding yes "${audio_args[@]}" &

  local pid=$!
  while kill -0 $pid 2>/dev/null && [[ ! -f "$filepath" ]]; do
    sleep 0.2
  done

  [[ -f "$filepath" ]] && echo "$filepath" >"$RECORDING_FILE"
}

stop_recording() {
  pkill -SIGINT -f gpu-screen-recorder

  local count=0
  while pgrep -f gpu-screen-recorder >/dev/null && ((count < 50)); do
    sleep 0.1
    count=$((count + 1))
  done

  local filename
  filename=$(cat "$RECORDING_FILE" 2>/dev/null || true)
  rm -f "$RECORDING_FILE"

  if [[ -n "$filename" && -f "$filename" ]]; then
    notify-send "Recording saved" "$(basename "$filename")"
  else
    notify-send "Recording stopped" "No file saved"
  fi
}

screenrecording_active() {
  pgrep -f gpu-screen-recorder >/dev/null
}

case "$ACTION" in
full)
  FILENAME="$OUTPUT_DIR/record_$(date +%Y%m%d_%H%M%S).mp4"
  start_recording "$FILENAME"
  notify-send "Recording started" "fullscreen"
  ;;
stop)
  stop_recording
  ;;
*)
  if screenrecording_active; then
    stop_recording
  else
    echo "Usage: cmd-screenrecord <full|stop>"
    exit 1
  fi
  ;;
esac

