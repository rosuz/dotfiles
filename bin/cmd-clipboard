#!/bin/bash
set -euo pipefail

COMMAND="${1:-}"

case "$COMMAND" in
list)
  cliphist list 2>/dev/null
  ;;
select)
  ID="$2"
  [[ -z "$ID" ]] && exit 1
  cliphist decode "$ID" | wl-copy
  ;;
reset)
  pkill wl-paste 2>/dev/null || true
  pkill cliphist 2>/dev/null || true
  printf "" | wl-copy || true
  rm -rf ~/.cache/cliphist/db
  sleep 0.2
  (
    wl-paste --watch cliphist store >/dev/null 2>&1 &
  )
  notify-send "Clipboard history reset" || true
  ;;
*)
  echo "Usage: clipboard <list|select <id>|reset>"
  exit 1
  ;;
esac
